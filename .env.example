# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cirerms
DB_PASSWORD=change_me
DB_NAME=cirerms
DB_POOL_LIMIT=10

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=8h

# File Uploads (stored outside public/, served via authenticated API)
UPLOAD_DIR=./storage/uploads
MAX_PHOTO_SIZE_MB=5
MAX_DOC_SIZE_MB=15
MAX_EXCEL_SIZE_MB=10
