# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cirerms
DB_PASSWORD=change_me
DB_NAME=cirerms
DB_POOL_LIMIT=10

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=8h

# Session lock: minutes without use before the screen locks (decimals allowed)
SESSION_IDLE_MINUTES=15

# File Uploads (stored outside public/, served via authenticated API)
UPLOAD_DIR=./storage/uploads
MAX_PHOTO_SIZE_MB=5
MAX_DOC_SIZE_MB=15
MAX_EXCEL_SIZE_MB=10

# Printouts (PDFs made by Chromium): see README section 7. All optional.
# Path of a system Chromium/Chrome (e.g. /usr/bin/chromium); empty uses the one inside @sparticuz/chromium
PDF_CHROMIUM_PATH=
# PDFs made at the same time
PDF_TAB_POOL_SIZE=2
# The browser closes after this long without a PDF (ms), and restarts after this many PDFs
PDF_BROWSER_IDLE_MS=60000
PDF_BROWSER_MAX_PAGES=300
# One PDF may take this long (ms); fonts are waited for at most this long (ms)
PDF_TIMEOUT_MS=60000
PDF_FONT_WAIT_MS=5000
# The largest page it will make (MB)
PDF_MAX_HTML_MB=10
# Where @sparticuz/chromium unpacks (empty: the system's temp folder)
PDF_TEMP_DIR=
